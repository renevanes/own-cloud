# ── Basis ──
NODE_ENV=production
DATA_DIR=/data
HTTP_PORT=3000
SMTP_PORT=2525
DOMAIN=jouwdomein.nl
HOSTNAME_FQDN=mail.jouwdomein.nl
MAIL_DOMAINS=jouwdomein.nl
MAIL_FROM=rene@jouwdomein.nl

# Lange willekeurige strings, bijv.: openssl rand -hex 32
SESSION_SECRET=
ICAL_TOKEN=

# ── Uitgaande mail ──
# Leeg = direct afleveren (Hetzner moet poort 25 voor je openzetten).
# Of via relay, bijv. Amazon SES (eu-west-1):
# SMTP_RELAY=smtps://SMTP_USER:SMTP_PASS@email-smtp.eu-west-1.amazonaws.com:465
SMTP_RELAY=
# Optioneel: eigen Rspamd-service, bijvoorbeeld http://rspamd:11333/ met het compose-profiel spam.
RSPAMD_URL=
DKIM_SELECTOR=eigen
DKIM_KEY_FILE=/data/dkim-private.pem

# ── TLS voor inkomende mail (STARTTLS), certificaat dat Caddy beheert ──
TLS_CERT_FILE=/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.jouwdomein.nl/mail.jouwdomein.nl.crt
TLS_KEY_FILE=/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.jouwdomein.nl/mail.jouwdomein.nl.key
